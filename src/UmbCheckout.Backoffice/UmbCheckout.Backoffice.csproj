<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <StaticWebAssetBasePath>App_Plugins</StaticWebAssetBasePath>
	  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>UmbHost Limited</Company>
    <Copyright>(c) $([System.DateTime]::Now.ToString(`yyyy`)) UmbHost Limited</Copyright>
    <PackageProjectUrl>https://umbcheckout.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UmbHost/UmbCheckout</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Description>An eCommerce solution for Umbraco</Description>
	  <AssemblyVersion>1.0.0.0</AssemblyVersion>
	  <FileVersion>1.0.0.0</FileVersion>
	  <VersionPrefix>1.0.0</VersionPrefix>
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>umbraco;ecommerce;umbcheckout;commerce;shop;checkout;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The backoffice client source is built with Vite into wwwroot/UmbCheckout, see the BuildClient target -->
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <None Include="Client\**" Exclude="Client\node_modules\**" Pack="false" />
  </ItemGroup>

  <!--
    Builds the backoffice client into wwwroot/UmbCheckout with npm, as the build output is not committed.
    Only runs when the client sources changed. Set SkipClientBuild=true to skip it (e.g. while running "npm run watch").
  -->
  <PropertyGroup>
    <ClientRoot>$(MSBuildProjectDirectory)\Client\</ClientRoot>
    <ClientOutputFolder>wwwroot\UmbCheckout\</ClientOutputFolder>
    <ClientEntryFile>umbcheckout.js</ClientEntryFile>
  </PropertyGroup>

  <ItemGroup>
    <ClientInputs Include="Client\src\**;Client\package.json;Client\package-lock.json;Client\vite.config.ts;Client\tsconfig.json" />
  </ItemGroup>

  <Target Name="RestoreClient" Condition="'$(SkipClientBuild)' != 'true' And !Exists('$(ClientRoot)node_modules')">
    <Exec Command="npm ci" WorkingDirectory="$(ClientRoot)" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreClient" Condition="'$(SkipClientBuild)' != 'true' And '$(DesignTimeBuild)' != 'true'" Inputs="@(ClientInputs)" Outputs="$(ClientOutputFolder)$(ClientEntryFile)">
    <Exec Command="npm run build" WorkingDirectory="$(ClientRoot)" />
  </Target>

  <!--
    The client output may not exist yet, or may have changed (hashed file names), when the project is evaluated,
    so replace the evaluated items with the files that exist after building the client
  -->
  <Target Name="IncludeClientOutput" AfterTargets="BuildClient" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Remove="$(ClientOutputFolder)**" />
      <_ClientOutputFiles Include="$(ClientOutputFolder)**" />
      <Content Include="@(_ClientOutputFiles)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\UmbCheckout.Core\UmbCheckout.Core.csproj" />
    <ProjectReference Include="..\UmbCheckout.Shared\UmbCheckout.Shared.csproj" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.0.0, 18.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0, 18.0.0)" />
	</ItemGroup>

</Project>
