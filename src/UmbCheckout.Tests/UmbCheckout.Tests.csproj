<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
	    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
      <PackageReference Include="Moq" Version="4.18.4" />
      <PackageReference Include="xunit" Version="2.4.2" />
      <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <!-- Real NPoco persistence tests run against in-memory SQLite (no Docker) and, as [Trait("Category", "Integration")], SQL Server in a container. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
      <PackageReference Include="Umbraco.Cms.Persistence.Sqlite" Version="[10.8.8, 11)" />
      <PackageReference Include="Umbraco.Cms.Persistence.SqlServer" Version="[10.8.8, 11)" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <PackageReference Include="Umbraco.Cms.Persistence.Sqlite" Version="[13.5.3, 14)" />
      <PackageReference Include="Umbraco.Cms.Persistence.SqlServer" Version="[13.5.3, 14)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\UmbCheckout.Backoffice\UmbCheckout.Backoffice.csproj" />
      <ProjectReference Include="..\UmbCheckout.Core\UmbCheckout.Core.csproj" />
      <ProjectReference Include="..\UmbCheckout.Shared\UmbCheckout.Shared.csproj" />
      <ProjectReference Include="..\UmbCheckout.Stripe\UmbCheckout.Stripe.csproj" />
      <ProjectReference Include="..\UmbCheckout.Stripe.Forms\UmbCheckout.Stripe.Forms.csproj" />
      <ProjectReference Include="..\UmbCheckout.Testing\UmbCheckout.Testing.csproj" />
      <ProjectReference Include="..\UmbCheckout.Stripe.uSync\UmbCheckout.Stripe.uSync.csproj" />
      <ProjectReference Include="..\UmbCheckout.uSync\UmbCheckout.uSync.csproj" />
    </ItemGroup>

  <ItemGroup>
    <Using Include="UmbCheckout.Testing.Nullability" />
  </ItemGroup>

</Project>
