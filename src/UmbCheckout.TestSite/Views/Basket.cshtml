@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Basket>
@{
    Layout = "_Master.cshtml";
    var currencyCode = Model.Root()?.Value<string>("umbCheckoutCurrencyCode");
}
<partial name="Partials/SectionHeader"/>
<style>
    table {
        border-collapse: collapse;
        width: 100%
    }

        table td {
            padding: 15px;
        }

        table thead th {
            background-color: #e7afa3;
            border: 1px solid #e7afa3;
            padding: 15px;
        }

        table tbody td {
            color: #636363;
            border: 1px solid #dddfe1;
        }

        table tbody tr {
            background-color: #f9fafb;
        }

            table tbody tr:nth-child(odd) {
                background-color: #ffffff;
            }
</style>
<section class="section section--sand">
    <div class="container">
        @if (TempData[UmbCheckout.Shared.Consts.TempData.UmbCheckoutBasketChangeCancelled] is string basketChangeCancelled)
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning" role="alert">@basketChangeCancelled</div>
                </div>
            </div>
        }
        @if (TempData[UmbCheckout.Shared.Consts.TempData.UmbCheckoutAddedToBasket] is Guid addedKey)
        {
            var lineItemContent = Umbraco.Content(addedKey);
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-success">
                        Successfully added @(lineItemContent?.TemplateId > 0 ? lineItemContent.Name : $"{lineItemContent?.Parent?.Name} - {lineItemContent?.Name}") to basket.
                    </div>
                </div>
            </div>
        }
        <vc:stripe-basket format-currency="@currencyCode" reduce-button-css-class="button button--border--solid" increase-button-css-class="button button--border--solid" remove-button-css-class="button button--border--solid" checkout-button-css-class="button button--border--solid"></vc:stripe-basket>
    </div>
</section>