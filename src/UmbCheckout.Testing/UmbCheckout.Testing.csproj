<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UmbHost.Licensing: project or package, see UmbCheckout/Directory.Build.props -->
    <ReferenceUmbHostLicensing>true</ReferenceUmbHostLicensing>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="xunit.extensibility.core" Version="2.4.2" />
    <PackageReference Include="Moq" Version="4.18.4" />
    <!-- StripeMockFixture; same range as UmbCheckout.Stripe -->
    <PackageReference Include="Stripe.net" Version="[50.3.0, 51)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmbCheckout.Shared\UmbCheckout.Shared.csproj" />
  </ItemGroup>

</Project>
