@using UmbCheckout.Shared.Enums
@using UmbCheckout.Shared.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<UmbCheckout.Core.ViewModels.BasketLinkViewModel>
<a class="@Model.LinkCssClass" href="@Model.LinkUrl">
    @Model.LinkName:

    @switch (Model.LinkType)
    {
        case BasketLinkType.TotalCount:
            @Model.TotalItems
            break;

        case BasketLinkType.SubTotal:
            @Model.SubTotal.FormatCurrency(Model.CurrencyCode)
            break;
    }
</a>