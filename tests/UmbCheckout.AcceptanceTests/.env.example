# Copy to .env and fill in. .env is gitignored.

# Base URL of the running starter kit site under test. Use HTTPS: backoffice auth does not work over plain HTTP.
# Local dev (see UmbCheckout.StarterKit.Web/Properties/launchSettings.json): https://localhost:44387
URL=https://localhost:44387

# Credentials of a superadmin user on that site.
UMBRACO_USER_LOGIN=acceptance@umbcheckout.local
UMBRACO_USER_PASSWORD=UmbCheckoutAcceptance1234!

# Where the authenticated backoffice session is cached between tests.
STORAGE_STATE_PATH=playwright/.auth/user.json

# Set to true when the site has a Stripe test API key configured (UmbCheckout:Stripe:Test:ApiKey).
# Without it the payment test is skipped, as the site cannot create a Stripe Checkout session.
STRIPE_CONFIGURED=false
