{
  "name": "umbcheckout-acceptance-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright acceptance tests for UmbCheckout, run against the UmbCheckout Starter Kit for Stripe.",
  "scripts": {
    "test": "playwright test",
    "test:backoffice": "playwright test --project backoffice",
    "test:storefront": "playwright test --project storefront",
    "ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@umbraco-cms/acceptance-test-helpers": "~17.6.2",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4"
  }
}
